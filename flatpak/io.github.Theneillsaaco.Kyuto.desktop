[Desktop Entry]
Type=Application
Name=Kyuto
Comment=YouTube Music player (.NET + Qt Bridge + libmpv)
Exec=kyuto
Icon=io.github.Theneillsaaco.Kyuto
Categories=AudioVideo;Audio;Player;Music;
Keywords=Music;YouTube;Player;Audio;
Terminal=false
StartupNotify=true
Actions=Mini;

[Desktop Action Mini]
Name=Mini player
Exec=kyuto --mini
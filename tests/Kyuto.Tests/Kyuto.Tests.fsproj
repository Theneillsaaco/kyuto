<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="4.0.3" />
        <PackageReference Include="FSharp.Core" Version="11.0.101" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="AutoplayTests.fs" />
      <Compile Include="ClockTests.fs" />
      <Compile Include="I18nTests.fs" />
      <Compile Include="LrcCopiesTests.fs" />
      <Compile Include="PlayErrorsTests.fs" />
      <Compile Include="SoundTests.fs" />
      <Compile Include="LastFmTests.fs" />
      <Compile Include="ListeningTests.fs" />
      <Compile Include="LyricsTests.fs" />
      <Compile Include="PrefetchTests.fs" />
      <Compile Include="ResumeTests.fs" />
      <Compile Include="QueueTests.fs" />
      <Compile Include="ScrobbleTests.fs" />
      <Compile Include="ThemeTests.fs" />
      <Compile Include="VideoTests.fs" />
      <Compile Include="CachePolicyTests.fs" />
      <Compile Include="LyricsExtrasTests.fs" />
      <Content Include="Data\m3color-oracle.json" />
      <Content Include="xunit.runner.json" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Kyuto.Core\Kyuto.Core.fsproj" />
      <ProjectReference Include="..\..\src\Kyuto.Scrobble\Kyuto.Scrobble.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Data\m3color-oracle.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>